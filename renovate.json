{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": [
        "actions/*",
        "docker/*",
        "sigstore/*"
      ],
      "groupName": "GitHub/Docker official actions"
    },
    {
      "description": "Automerge GitHub Actions minor/patch updates (by Muse)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    }
  ],
  "bumpVersions": [
    {
      "name": "Application version",
      "filePatterns": ["version.go"],
      "matchStrings": [
        "const APP_VERSION\\s*=\\s*['\"]v(?<version>\\d+\\.\\d+\\.\\d+)['\"]"
      ],
      "bumpType": "patch"
    }
  ],
  "assignees": [
    "mkaraki"
  ]
}